{
  "name": "search-scrape-mcp",
  "version": "1.0.0",
  "license": "MIT",
  "bin": {
    "search-scrape-mcp": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "src/providers/yt-dlp.py",
    "USAGE.md"
  ],
  "scripts": {
    "test": "npm run build && node dist/config/report.js --check-docs && node --test \"dist/**/*.test.js\"",
    "build": "tsc",
    "start": "node dist/server/main.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "npm run build && node dist/server/smoke.js",
    "config": "npm run build --silent && node dist/config/report.js",
    "config:docs": "npm run build --silent && node dist/config/report.js --write-docs"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "defuddle": "0.19.6",
    "file-type": "^22.3.0",
    "ipaddr.js": "^2.5.0",
    "linkedom": "0.18.15",
    "mime-types": "^3.0.2",
    "p-queue": "^10.0.0",
    "playwright-core": "^1.65.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
